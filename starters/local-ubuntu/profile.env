#=============================================================================
# Profil : local-ubuntu
# Démarrage complet sur une machine locale Ubuntu
#=============================================================================

KANISSA_DESCRIPTION="Stack complète sur machine locale Ubuntu"

# Composants activés (ordre de démarrage, couche par couche)
# Format : "dossier-couche/dossier-composant"
# Commenter une ligne pour désactiver un composant
KANISSA_COMPONENTS="
  2.locals-subscriptions/ollama-embedded
  3.proxy/llm-proxy
  4.tools/heure
  6.workspace/current-folder  
  10.clients/wetty  
"

#--- Variables spécifiques au profil ----------------------------------------

# Ollama
OLLAMA_PORT=11434
OLLAMA_MODELS="gemma3:270m"

# LiteLLM Proxy
LITELLM_PORT=4000
LITELLM_MASTER_KEY="sk-kanissa-local"

# Clients
OPEN_WEBUI_PORT=8080
OPEN_WEBUI_AUTH=false
WETTY_PORT=3000
CODE_SERVER_PORT=8443

# Workspace
KANISSA_WORKSPACE_DIR="${HOME}/workspace"

# Général
TZ="Europe/Paris"
