#=============================================================================
# Profil : local-ubuntu
# Démarrage complet sur une machine locale Ubuntu
#=============================================================================

KANISSA_DESCRIPTION="Stack complète sur machine locale Ubuntu"

# Composants activés (ordre de démarrage, couche par couche)
# Format : "dossier-couche/dossier-composant"
# Commenter une ligne pour désactiver un composant
KANISSA_COMPONENTS="
  2.locals-subscriptions/ollama-embedded
  3.proxy/llm-proxy
  4.tools/heure
  6.workspace/containerized
  10.clients/wetty  
"

#--- Variables spécifiques au profil ----------------------------------------

# Ollama
OLLAMA_PORT=11434
OLLAMA_MODELS="gemma3:270m"

# LiteLLM Proxy
LITELLM_PORT=4000
LITELLM_MASTER_KEY="sk-kanissa-local"

# Clients
OPEN_WEBUI_PORT=8080
OPEN_WEBUI_AUTH=false
WETTY_PORT=3000
WETTY_SSH_HOST=kanissa-workspace
WETTY_SSH_USER=root
CODE_SERVER_PORT=8443

# Workspace
WORKSPACE_SSH_PORT=7727
KANISSA_WORKSPACE_DIR="${HOME}/workspace"

# Claude Code — via LLM Proxy (LiteLLM)
ANTHROPIC_API_KEY="${LITELLM_MASTER_KEY}"
ANTHROPIC_BASE_URL="http://kanissa-litellm:4000"

# Claude Code — API directe Anthropic (décommenter pour bypass le proxy)
# ANTHROPIC_API_KEY="sk-ant-..."
# ANTHROPIC_BASE_URL=

# Claude Code — Google Vertex AI (décommenter pour activer)
# CLAUDE_CODE_USE_VERTEX=1
# CLOUD_ML_REGION="us-east5"
# ANTHROPIC_VERTEX_PROJECT_ID="my-gcp-project"

# Général
TZ="Europe/Paris"
