#=============================================================================
# Profil : cloud-workstation
# Démarrage depuis une Google Cloud Workstation
#=============================================================================

KANISSA_DESCRIPTION="Stack pour Google Cloud Workstation"

# Composants activés (ordre de démarrage)
KANISSA_COMPONENTS="
  2.locals-subscriptions/ollama-embedded
  3.proxy/llm-proxy
  4.tools/heure
  6.workspace/containerized
  10.clients/open-webui
"

#--- Variables spécifiques au profil ----------------------------------------

# Ollama
OLLAMA_PORT=11434
OLLAMA_MODELS="llama3"

# LiteLLM Proxy
LITELLM_PORT=4000
LITELLM_MASTER_KEY="sk-kanissa-cloud"

# Cloud providers (décommenter selon abonnements)
# AZURE_API_KEY=""
# AZURE_API_BASE=""

# Claude Code — Google Vertex AI (décommenter pour activer)
# CLAUDE_CODE_USE_VERTEX=1
# CLOUD_ML_REGION="europe-west1"
# ANTHROPIC_VERTEX_PROJECT_ID="my-gcp-project"

# Client
OPEN_WEBUI_PORT=8080
OPEN_WEBUI_AUTH=true

# Général
TZ="Europe/Paris"
