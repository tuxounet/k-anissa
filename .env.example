# .env.example — Copier en .env et remplir les valeurs

# ── Google Vertex AI (requis pour les stacks cloud : lab, claude-code-proxy-vertex) ──
# Région GCP (ex: europe-west1, us-central1)
CLOUD_ML_REGION=europe-west1
# ID du projet GCP contenant l'accès Vertex AI
ANTHROPIC_VERTEX_PROJECT_ID=
# Clé API Google Cloud avec accès Vertex AI
# Créer dans GCP Console > APIs & Services > Credentials > Create API Key
# Activer l'API "Vertex AI API" sur le projet
VERTEX_API_KEY=

# Optionnel — surcharges locales
# ANISSA_DATA=           # Défaut : .data/
# ANISSA_NETWORK=        # Défaut : anissa
# TZ=                    # Défaut : Europe/Paris